{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "chrome-devtools": {
        "type": "local",
        "command": ["npx", "-y", "chrome-devtools-mcp@latest", "--autoConnect"]
      },
      // "miro-mcp": {
      //  "type": "remote",
      //  "url": "https://mcp.miro.com/",
      //  "oauth": {}
      //}
    }
  },
  "permissions": [
    {"action": "lsp", "resource": "*", "effect": "allow"},
    {"action": "question", "resource": "*", "effect": "allow"},
    {"action": "skill", "resource": "*", "effect": "allow"},
    {"action": "webfetch", "resource": "*", "effect": "allow"},
    {"action": "external_directory", "resource": "~/.cache/opencode/**", "effect": "allow"},
    {"action": "external_directory", "resource": "~/.config/opencode/**", "effect": "allow"},
    {"action": "external_directory", "resource": "~/.local/share/**", "effect": "allow"},
    {"action": "external_directory", "resource": "/private/tmp/**", "effect": "allow"},
    {"action": "external_directory", "resource": "/private/var/**", "effect": "allow"},
    {"action": "external_directory", "resource": "/tmp/**", "effect": "allow"},
    {"action": "external_directory", "resource": "/var/folders/**", "effect": "allow"},
    {"action": "external_directory", "resource": "/var/tmp/**", "effect": "allow"}
  ],
  "plugins": [
    // "@tarquinen/opencode-dcp@latest",
    "@unfrgivn/opencode-config@latest"
  ]
}
