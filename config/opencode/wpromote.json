{
  "agentNames": "lotr",
  "models": {
    "aragorn": "github-copilot/gpt-5.6-luna",
    "celebrimbor": "github-copilot/gpt-5.6-luna",
    "gandalf": "github-copilot/gpt-6-astra",
    "galadriel": "github-copilot/gemini-3.8-flash"
  },
  "agentOverrides": {
    "aragorn": {
      "reasoningEffort": "xhigh"
    },
    "celebrimbor": {
      "reasoningEffort": "xhigh"
    }
  },
  "preset": "github-copilot",
  "presets": {
    "github-copilot": {
      "description": "GitHub Copilot-backed defaults. Fill model overrides here after re-pasting the slim model IDs.",
      "models": {}
    },
    "openai": {
      "description": "OpenAI-backed defaults. Fill model overrides here after re-pasting the slim model IDs.",
      "models": {}
    },
    "opencode-go": {
      "description": "Opencode Go defaults. Fill model overrides here after re-pasting the slim model IDs.",
      "models": {}
    }
  },
  "orchestration": {
    "limits": {
      "maxConcurrent": 3,
      "maxConcurrentGlobal": 5
    },
    "tmux": {
      "enabled": false,
      "mode": "pane",
      "layout": "main-vertical",
      "mainPaneSize": 60
    }
  },
  "companion": {
    "enabled": true,
    "position": "bottom-right",
    "size": "medium",
    "gifPack": "default",
    "loopStyle": "classic",
    "speed": 1,
    "debug": false
  }
}
