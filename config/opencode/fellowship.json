{
  "$schema": "./schemas/fellowship.schema.json",
  "agentNames": "lotr",
  "models": {
    "aragorn": "github-copilot/gpt-5.6-luna",
    "celebrimbor": "github-copilot/gpt-5.6-luna",
    "elrond": "github-copilot/gpt-5.6-luna",
    "gandalf": "github-copilot/claude-opus-5.5",
    "galadriel": "github-copilot/gemini-3.8-flash",
    "legolas": "github-copilot/gpt-5.6-luna",
    "radagast": "github-copilot/gpt-5.6-luna",
    "treebeard": "github-copilot/gpt-5.6-luna"
  },
  "agentOverrides": {
    "aragorn": {
      "reasoningEffort": "xhigh"
    },
    "celebrimbor": {
      "reasoningEffort": "xhigh"
    },
    "elrond": {
      "reasoningEffort": "xhigh"
    },
    "radagast": {
      "reasoningEffort": "xhigh"
    },
    "treebeard": {
      "reasoningEffort": "xhigh"
    }
  },
  "preset": "github-copilot",
  "presets": {
    "github-copilot": {
      "description": "GitHub Copilot-backed defaults. Fill model overrides here after re-pasting the slim model IDs.",
      "models": {}
    },
    "openai": {
      "description": "OpenAI-backed defaults. Fill model overrides here after re-pasting the slim model IDs.",
      "models": {}
    },
    "opencode-go": {
      "description": "Opencode Go defaults. Fill model overrides here after re-pasting the slim model IDs.",
      "models": {}
    }
  },
  "orchestration": {
    "limits": {
      "maxConcurrent": 3,
      "maxConcurrentGlobal": 5
    },
    "tmux": {
      "enabled": false,
      "mode": "pane",
      "layout": "main-vertical",
      "mainPaneSize": 60
    }
  },
  "companion": {
    "enabled": true,
    "position": "bottom-right",
    "size": "medium",
    "gifPack": "default",
    "loopStyle": "classic",
    "speed": 1,
    "debug": false
  }
}
